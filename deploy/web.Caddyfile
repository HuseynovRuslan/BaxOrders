# This stack's own front door — not the VPS's. The shared Caddy on the host terminates HTTPS for
# order.qrlog.az and forwards to this container by name; everything below happens inside the stack.
#
# One origin, three rules: the API's two prefixes go to the API container, and everything else is the SPA.
:8080 {
	encode zstd gzip

	# The API owns these two prefixes. `/health` is deliberately reachable: a monitor has to be able to ask
	# whether the service is up without an account, which is why the API leaves it anonymous.
	handle /api/* {
		reverse_proxy baxorders-api:8080
	}
	handle /health {
		reverse_proxy baxorders-api:8080
	}

	# The SPA owns its own routes. A reload on /dashboard or /locations/12 is not a missing file — it is the
	# application shell, which then reads the address itself.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# The hashed asset names make a long cache safe; index.html must never be cached, or a browser keeps asking
	# for the chunks of a build that no longer exists.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@shell path / /index.html
	header @shell Cache-Control "no-cache"

	log {
		output stdout
		format console
	}
}
