# /opt/baxorders/.env — the ONLY place production secrets live (chmod 600, owner deploy). Never committed.
# This example documents the keys; the real file is written on the server with generated values.

# PostgreSQL — this stack's own container, no published port, nothing shared with another project.
POSTGRES_PASSWORD=            # bootstrap superuser; used by db/init and by pg_restore, never by the API
APP_DB_NAME=baxorders
APP_DB_USER=baxorders         # least-privilege application role
APP_DB_PASSWORD=

# Networking
SHARED_PROXY_NETWORK=attendanceqr_default   # the shared reverse proxy's network (external; the QRLog stack owns it)
APP_HTTP_PORT=8050                          # loopback-only diagnostics port on the VPS

# Release
IMAGE_TAG=local               # set by deploy/scripts/deploy.sh to the release id
BAXORDERS_COMMIT=unknown      # set by deploy/scripts/deploy.sh to the deployed commit

# First administrator — read only when the database has no accounts at all. The production database is restored
# from the real one and already has its users, so these stay empty here.
Auth__BootstrapAdmin__UserName=
Auth__BootstrapAdmin__DisplayName=
Auth__BootstrapAdmin__Password=
